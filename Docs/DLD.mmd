%% 5. Low Level Designing - Job Scheduling System

graph LR

    %% ──────────────────────────────────────────────
    %% Styles
    %% ──────────────────────────────────────────────
    classDef client fill:#f5f5f5,stroke:#333,stroke-width:2px
    classDef gateway fill:#e8e8e8,stroke:#333,stroke-width:2px
    classDef service fill:#fff,stroke:#333,stroke-width:1.5px
    classDef db fill:#f0e6d3,stroke:#8b7355,stroke-width:2px
    classDef kafka fill:#e6f3e6,stroke:#2e7d32,stroke-width:2px
    classDef redis fill:#ffe6e6,stroke:#c62828,stroke-width:2px
    classDef executor fill:#e3f2fd,stroke:#1565c0,stroke-width:1.5px
    classDef watcher fill:#fff3e0,stroke:#e65100,stroke-width:2px
    classDef note fill:#fffde7,stroke:#f9a825,stroke-width:1px,font-size:10px

    %% ──────────────────────────────────────────────
    %% Nodes
    %% ──────────────────────────────────────────────

    CLIENTS[("clients / users")]:::client

    LBGW["LB + API Gateway\n─────────────────\n• authentication &\n  authorization\n• rate limiting\n• caching"]:::gateway

    JOB_SVC["Job Svc"]:::service
    SEARCH_SVC["Job Search Svc"]:::service

    KAFKA_INGEST["Kafka\n(ingest)"]:::kafka
    CONSUMER_SVC["Consumer Svc"]:::service

    JOB_DB[("Job DB
(Postgres)
─────────────────
Job

• id (index)
• name
• schedule_type
• status
  (paused/
   scheduled/
   cancel)
• schedule_time
  (partition)
• cron_expression
• payload
• retries
• meta
─────────────────
Job_run

• id
• job_id (index)
• status (index)
  (queued/
   running/
   success/
   failed)
• start_time
• end_time
• modification_time
  (index)
• attempt_number
• executor_id
• error_msg")]
::db

    REDIS_POLL[("Redis\n(last_polled_time)")]:::redis

    WATCHER["watcher"]:::watcher

    KAFKA_EXEC["Kafka\n─────────────────\n• topic: run\n• topic: retry\n• topic: dead"]:::kafka

    JOB_CONSUMER["Job Consumer Svc"]:::service

    EXEC1["Executor Svc"]:::executor
    EXEC2["Executor Svc"]:::executor
    EXEC3["Executor Svc"]:::executor
    EXEC4["Executor Svc"]:::executor
    EXEC5["Executor Svc"]:::executor

    REDIS_MAIN[("Redis\n(Details in notes.txt)\n─────────────────\njob: 1232,\nrequest: cancel,\nTTL")]:::redis

    %% ──────────────────────────────────────────────
    %% Flows — Client to Services
    %% ──────────────────────────────────────────────

    CLIENTS -->|requests| LBGW
    LBGW -->|"submit / edit the jobs"| JOB_SVC
    LBGW --> SEARCH_SVC

    %% ──────────────────────────────────────────────
    %% Flows — Job Ingestion Path
    %% ──────────────────────────────────────────────

    JOB_SVC -->|publish| KAFKA_INGEST
    KAFKA_INGEST --> CONSUMER_SVC
    CONSUMER_SVC -->|write| JOB_DB

    %% ──────────────────────────────────────────────
    %% Flows — Immediate Job Execution
    %% ──────────────────────────────────────────────

    JOB_SVC -->|"1. immdiate job direclty in the executor kafka\n2. The gap between Scheuled time of job and current time is <20s. "| KAFKA_EXEC

    %% ──────────────────────────────────────────────
    %% Flows — Job Search / Read Path
    %% ──────────────────────────────────────────────

    SEARCH_SVC -->|read| JOB_DB

    %% ──────────────────────────────────────────────
    %% Flows — Watcher Polling
    %% ──────────────────────────────────────────────

    WATCHER -->|"read every 20s\n• pull jobs scheduled in\n  [now, now+5min]\n  & mark as 'Queued'\n• fetch jobs where status\n  is 'running' & last\n  modified > 10s ago , (reason for this in notes.txt)"| JOB_DB

    WATCHER -->|last_polled_time| REDIS_POLL

    WATCHER -->|"watcher then forwards the jobs in kafka "|KAFKA_EXEC

    %% ──────────────────────────────────────────────
    %% Flows — Job Execution Path
    %% ──────────────────────────────────────────────

    KAFKA_EXEC --> JOB_CONSUMER

    JOB_CONSUMER -->|"101 .. 1-100\n(fan out)"| EXEC1
    JOB_CONSUMER --> EXEC2
    JOB_CONSUMER --> EXEC3
    JOB_CONSUMER --> EXEC4
    JOB_CONSUMER --> EXEC5

    %% ──────────────────────────────────────────────
    %% Flows — Executor → Kafka (ingest) heartbeat
    %% ──────────────────────────────────────────────

    EXEC1 -->|"job status heartbeat\n(every 10s)"| KAFKA_INGEST
    EXEC2 --> KAFKA_INGEST
    EXEC3 --> KAFKA_INGEST
    EXEC4 --> KAFKA_INGEST
    EXEC5 --> KAFKA_INGEST

    %% ──────────────────────────────────────────────
    %% Flows — Cancel
    %% ──────────────────────────────────────────────

    
    JOB_SVC -->|"cancel\n(This flow is when \n the user wants to stop \nrunnig job)"| REDIS_MAIN
 
    EXEC2 -->|"dedicated thread connecting Exec to Redis\n same for all Execs"| REDIS_MAIN

    %% ──────────────────────────────────────────────
    %% Flows — Retry / Failure Handling
    %% ──────────────────────────────────────────────

    EXEC1 -. "1. failed job back to\nKafka for retry\n2. if attempt_number > retries, push in the 'dead' topic instead" .-> KAFKA_EXEC
    JOB_CONSUMER -. "1. update retry count\n via ingest Kafka\n2. also push the dead status jobs in DM" .-> KAFKA_INGEST


